# ==============================================================================
# Flow MCP Environment Variables
# ==============================================================================
# Copy this file to .env and adjust the values to your setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Google AI Studio (Gemini) API Key
# ------------------------------------------------------------------------------
# Required for flow_narrate (TTS voiceovers with Flow-matching Gemini voices).
# Get a key from: https://aistudio.google.com/apikey
# Real keys start with "AIza" and are ~39 characters long.
# (Alternatively, you can save the key via Flow Studio UI or ~/.flow-mcp/gemini-key)
# GEMINI_API_KEY=

# Gemini TTS model name (default: "gemini-2.5-flash-preview-tts")
# FLOW_MCP_GEMINI_TTS=gemini-2.5-flash-preview-tts

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
# HTTP port for the Flow Studio web panel (default: 8787)
FLOW_MCP_PORT=8787

# Chrome DevTools Protocol (CDP) port for automating Flow (default: 9333)
FLOW_MCP_CDP_PORT=9333

# Max milliseconds an MCP tool call waits before returning a background task_id
# Keeps tool calls safely under the desktop client / LLM 60s timeout (default: 45000)
FLOW_MCP_PATIENCE_MS=45000

# ------------------------------------------------------------------------------
# Directories & Storage
# ------------------------------------------------------------------------------
# Root output directory for downloaded videos, images, and projects
# Default: ~/flow-mcp-out (e.g. C:\Users\<Username>\flow-mcp-out on Windows)
# FLOW_MCP_OUTPUT=

# Flow MCP home directory for the dedicated Chrome profile, tokens, and state
# Default: ~/.flow-mcp (e.g. C:\Users\<Username>\.flow-mcp on Windows)
# FLOW_MCP_HOME=

# ------------------------------------------------------------------------------
# Executable Paths (Optional - auto-detected if installed in standard locations)
# ------------------------------------------------------------------------------
# Path to Google Chrome executable. Auto-detected from default OS locations if empty.
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux example: /usr/bin/google-chrome
# FLOW_MCP_CHROME=

# Path to ffmpeg executable (default: ffmpeg)
# Used for video assembly, narration audio merging, and last-frame extraction.
# FLOW_MCP_FFMPEG=ffmpeg

# Path to ffprobe executable (default: ffprobe)
# Used to inspect clip dimensions and durations during assembly.
# FLOW_MCP_FFPROBE=ffprobe

# Path to macOS "say" command for local offline voice fallback (default: say)
# FLOW_MCP_SAY=say

# ------------------------------------------------------------------------------
# Generation Pacing & Queue Tuning
# ------------------------------------------------------------------------------
# Minimum pause in seconds between generation requests (default: 25)
# FLOW_MCP_PAUSE_MIN_S=25

# Maximum pause in seconds between generation requests (default: 70)
# FLOW_MCP_PAUSE_MAX_S=70

# ------------------------------------------------------------------------------
# Testing & Development Hooks
# ------------------------------------------------------------------------------
# Test hook: pretend a scene failed in an agent batch (e.g. FLOW_MCP_SIMULATE_MISSING=2)
# FLOW_MCP_SIMULATE_MISSING=0
